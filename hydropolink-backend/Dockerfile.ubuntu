# Fallback only if the Jupyter-based image fails to build. Then sklearn may
# differ from the notebook: run deploy.sh with ALLOW_SKEW=1, or pip install the
# API's sklearn version inside Jupyter before training.
FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-pip python3-numpy python3-sklearn python3-joblib \
    python3-bs4 python3-requests && rm -rf /var/lib/apt/lists/*
COPY requirements.txt .
RUN pip3 install --no-cache-dir --break-system-packages fastapi uvicorn
COPY backend/ ./backend/
COPY verify_sources.py .
EXPOSE 8000
CMD ["python3", "-m", "uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8000"]
